# Base URL of the Synapse inference backend, baked into the static build at build time.
# Local dev: leave unset (defaults to http://localhost:8000).
# Production (Cloudflare Pages): set to the deployed API origin, e.g. https://api.vkvstudio.com
#
# Pages deploys are DIRECT UPLOAD (wrangler), so the bundle is built on this
# machine and these values come from the shell — not from the Pages dashboard.
# Build for production with them set explicitly, or the bundle ships pointing at
# localhost and every visitor silently gets the mock assistant:
#
#   PUBLIC_SYNAPSE_API_URL=https://api.vkvstudio.com \
#   PUBLIC_GOOGLE_OAUTH_CLIENT_ID=<web client id> \
#   pnpm run build && pnpm dlx wrangler pages deploy
#
# The host must stay in sync with connect-src in public/_headers.
PUBLIC_SYNAPSE_API_URL=

# Google OAuth *Web* client id (PUBLIC — not a secret) for Synapse conversation
# ownership. Create in Google Cloud Console → Credentials → OAuth client → Web.
# Authorized JavaScript origins: http://localhost:4173 (dev) + https://vkvstudio.com (prod).
# Leave unset → sign-in is disabled and chats stay local-only (IndexedDB). The
# same id must be set on the backend as SYNAPSE_GOOGLE_OAUTH_CLIENT_ID.
PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
