---
import type { Lang } from '@i18n/utils';
import { t, supportedLangs } from '@i18n/utils';
import CookieConsent from '@components/ui/CookieConsent.svelte';
import { CONTACT_EMAIL } from '@/lib/site-config';
import '@styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Open Graph type — 'website' for nearly everything on this site. */
  ogType?: 'website' | 'article';
  /** ISO date. Only meaningful with ogType="article" — og:type=article
   *  without a published time is an incomplete card that crawlers and social
   *  previews both notice. */
  articlePublished?: string;
  articleModified?: string;
  /** Absolute path to an OG/Twitter image. Defaults to the locale's share card. */
  ogImage?: string;
  /** Extra JSON-LD nodes for this specific page (SoftwareApplication, BreadcrumbList, ...).
   *  Each entry must be a complete, self-contained node (its own "@context"/"@type"). */
  jsonLd?: Record<string, unknown>[];
}

const {
  lang: propsLang,
  title,
  description,
  ogType = 'website',
  ogImage,
  articlePublished,
  articleModified,
  jsonLd = [],
} = Astro.props;
const lang = propsLang || ((Astro.url.pathname.startsWith('/ru') ? 'ru' : 'en') as Lang);
const pageTitle = title || t(lang, 'meta.title');
const pageDescription = description || t(lang, 'meta.description');

const SITE_URL = 'https://vkvstudio.com';

// --- Canonical + hreflang: derived from the CURRENT route, never the lang root. ---
// e.g. rawPath "/en/lab/tokenizer/" -> restPath "/lab/tokenizer/"
//      rawPath "/ru/"               -> restPath "/"
const rawPath = Astro.url.pathname;
const restPath = rawPath.replace(/^\/(en|ru)(\/|$)/, '/') || '/';
const canonicalUrl = `${SITE_URL}/${lang}${restPath}`;
const alternateUrls: Record<Lang, string> = {
  en: `${SITE_URL}/en${restPath}`,
  ru: `${SITE_URL}/ru${restPath}`,
};
const xDefaultUrl = alternateUrls.en;

// The sitewide FAQPage block was REMOVED 2026-08-09 and now lives on the home
// page only, built from src/data/faq.ts — the same array the visible FAQ
// section renders, so markup and copy cannot drift apart.
// Why it had to move: the identical six questions were emitted on ALL 12 pages
// while appearing in the body of none, so the privacy policy was carrying
// "Can I hire Valery?" in its structured data. Google requires marked-up
// content to be visible. (Note this is a JS comment, not an HTML one — the
// previous version of this note was an HTML comment and therefore shipped the
// word "FAQPage" to every page it was supposed to have been removed from.)
/**
 * Share card. The default used to be the 1024x1024 logo at 534 KB, paired with
 * `twitter:card: summary` — a correct pairing, but it buys the smallest preview
 * a platform offers: a thumbnail beside the text. Every social platform and
 * chat app lays out link previews for 1.91:1, so a purpose-made 1200x630 card
 * gets the large treatment instead, at 66 KB rather than 534.
 *
 * Localised, because the card carries a sentence: an English subtitle under a
 * Russian page is the sort of detail people notice and nobody mentions.
 * `Organization.logo` in the JSON-LD below still points at the square logo —
 * that field wants a logo, not a banner.
 */
const OG_COVER = { en: '/og-cover.jpg', ru: '/og-cover-ru.jpg' } as const;
const resolvedOgImage = `${SITE_URL}${ogImage || OG_COVER[lang as 'en' | 'ru'] || OG_COVER.en}`;
const ogImageAlt =
  lang === 'ru'
    ? 'VKVstudio — студия AI-инженерии: дообученная Gemma 4, RAG и три инструмента в браузере'
    : 'VKVstudio — AI engineering studio: a fine-tuned Gemma 4, RAG, and three browser tools';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />

    <!-- Self-hosted fonts preload — only the Inter subset for THIS locale is on the
         critical path (EN pages don't fetch the Cyrillic subset and vice-versa); the
         other subset still loads on demand via @font-face when a glyph needs it. -->
    {
      lang === 'ru' ? (
        <link
          rel="preload"
          href="/fonts/inter-cyrillic.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      ) : (
        <link
          rel="preload"
          href="/fonts/inter-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    {
      /* Same branch as Inter above — this one was unconditional, so /ru/ spent a
         preload slot on the LATIN subset it barely renders while the Cyrillic
         one it actually needs waited for @font-face discovery. */
      lang === 'ru' ? (
        <link
          rel="preload"
          href="/fonts/jetbrains-mono-cyrillic.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      ) : (
        <link
          rel="preload"
          href="/fonts/jetbrains-mono-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    <!-- Canonical: self-referential — this page's own URL, NEVER the lang root -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang: equivalent page in each locale, derived from the current path -->
    {
      supportedLangs.map((altLang) => (
        <link rel="alternate" hreflang={altLang} href={alternateUrls[altLang]} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- OG Tags -->
    <meta property="og:site_name" content="VKVstudio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {
      ogType === 'article' && articlePublished && (
        <meta property="article:published_time" content={articlePublished} />
      )
    }
    {
      ogType === 'article' && articleModified && (
        <meta property="article:modified_time" content={articleModified} />
      )
    }
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={resolvedOgImage} />
    {
      /* Dimensions describe the default card only — a caller-supplied ogImage
        has unknown size, and declaring the wrong one is worse than declaring
        none: the scraper reserves a box the image does not fill. */
    }
    {
      !ogImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- summary_large_image, now that a real 1200x630 card exists.
         This was deliberately `summary` while the only image was the square
         1024x1024 logo: summary_large_image expects roughly 1.91:1 and
         centre-crops anything else, which cut the top and bottom off the logo
         on every share to X, LinkedIn, Slack and Discord. The card is
         purpose-built at that ratio now, so the large treatment fits. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <title>{pageTitle}</title>

    <!-- Favicon (placeholder) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Structured Data -->

    <!-- One connected graph, not three disconnected copies of the same human.
         Every node carries an @id and references the others by @id, so a search
         engine resolves "Valery Karpov", "VKVstudio" and this website to one
         entity instead of guessing. The Organization node exists to state, in
         machine-readable form, that there is a REGISTERED business behind the
         site — the state registration number, taxpayer number and activity code
         are public register data and are what separates a real company from a
         personal page. Identity-document numbers are deliberately absent, and
         the address is city-level: enough to establish jurisdiction, not enough
         to locate a person. -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${SITE_URL}/#website`,
        name: 'VKVstudio',
        url: `${SITE_URL}/`,
        inLanguage: supportedLangs,
        publisher: { '@id': `${SITE_URL}/#organization` },
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${SITE_URL}/#organization`,
        name: 'VKVstudio',
        legalName: 'Karpov Valeriy Ivanovich, Individual Entrepreneur',
        alternateName: 'ԿԱՐՊՈՎ ՎԱԼԵՐԻ ԻՎԱՆԻ, Անհատ ձեռնարկատեր',
        url: `${SITE_URL}/`,
        email: CONTACT_EMAIL,
        // Registered with the State Register of Legal Entities, Ministry of
        // Justice of Armenia. The registration DATE is the credibility signal
        // a reader actually uses; the registry NUMBERS are not published here.
        // They were, alongside a `taxID` that in fact held the owner's ՀԾՀ —
        // his personal social-security identifier, machine-readable, on every
        // page. Nobody verifies a sole proprietor against the Armenian
        // register from a portfolio site, so the numbers bought no trust while
        // handing anyone the exact set of fields needed to impersonate the
        // business. If an invoice or a partner form ever needs the ՀՎՀՀ, it
        // belongs in that document, not in the site's structured data.
        foundingDate: '2026-02-12',
        logo: `${SITE_URL}/vkv-logo.png`,
        // NACE 62.01 / ISIC 6201 — computer programming activities.
        isicV4: '6201',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Gyumri',
          addressRegion: 'Shirak',
          addressCountry: 'AM',
        },
        founder: { '@id': `${SITE_URL}/#person` },
        knowsLanguage: ['en', 'ru'],
        description:
          'Registered sole proprietorship in Armenia building AI systems and web engineering — LLM fine-tuning, RAG, embeddings and self-hosted inference on an all-Google open-model stack.',
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        '@id': `${SITE_URL}/#person`,
        name: 'Valery Karpov',
        givenName: 'Valery',
        familyName: 'Karpov',
        url: 'https://vkvstudio.com',
        email: CONTACT_EMAIL,
        jobTitle: 'AI Architect & Web Engineer',
        worksFor: { '@id': `${SITE_URL}/#organization` },
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Gyumri',
          addressCountry: 'AM',
        },
        // The topics this site actually demonstrates, not just the frameworks
        // it is built with — an engine matching a question to an expert needs
        // the subject matter, not the toolchain.
        knowsAbout: [
          'LLM fine-tuning',
          'QLoRA',
          'Retrieval-Augmented Generation',
          'Text embeddings',
          'Tokenization',
          'Prompt engineering',
          'MLOps',
          'Self-hosted LLM inference',
          'Gemma',
          'Google Cloud AI',
          'Astro',
          'Svelte',
          'GSAP',
        ],
        sameAs: [
          'https://github.com/smartbulldog-pro',
          'https://www.linkedin.com/in/smartbulldog',
          'https://www.facebook.com/share/17uECE6UEA/',
          'https://www.instagram.com/smart_bulldog',
        ],
        description:
          'Full-stack engineer and AI architect with 20 years of experience. From photography to pipelines.',
      })}
    />

    <!-- Per-page JSON-LD (SoftwareApplication for Lab tools, BreadcrumbList, ...) -->
    {jsonLd.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t(lang, 'a11y.skipToContent')}</a>
    <slot />
    <CookieConsent lang={lang} client:idle />
  </body>
</html>
