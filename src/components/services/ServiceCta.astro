---
/**
 * ServiceCta — the closing block of every service and case page.
 *
 * One job: a visitor who read this far must never have to hunt for the next
 * step. Primary action → the contact funnel; email stays visible as the
 * fallback for form-averse buyers; the trust line compresses the Trust &
 * Process page into one glanceable sentence and links to the full version.
 */
import type { Lang } from '@i18n/utils';
import { t } from '@i18n/utils';
import { CONTACT_EMAIL } from '@/lib/site-config';

interface Props {
  lang: Lang;
  /**
   * Optional per-page "what happens next" line — the specific outcome a
   * buyer on THIS page gets, not the generic close every other page also
   * shows. Pages that pass nothing render exactly as before (backward
   * compatible by construction — this whole block is gated on the prop).
   * Source strings live under `services.ctaOutcomes.*` in en.json/ru.json;
   * pass an already-resolved `t(lang, 'services.ctaOutcomes.<page>')` string.
   */
  outcome?: string;
}

const { lang, outcome } = Astro.props;
---

<section class="service-cta">
  <div class="container">
    <div class="service-cta__panel">
      <h2 class="service-cta__heading text-h2">{t(lang, 'services.ctaHeading')}</h2>
      <p class="service-cta__sub">{t(lang, 'services.ctaSub')}</p>
      {outcome && <p class="service-cta__outcome">{outcome}</p>}
      <div class="service-cta__actions">
        <a href={`/${lang}/contact/`} class="service-cta__primary">
          {t(lang, 'services.contactCta')}
          <span aria-hidden="true">→</span>
        </a>
        <span class="service-cta__email">
          {t(lang, 'services.emailFallback')}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </span>
      </div>
      <p class="service-cta__trust text-mono">
        {t(lang, 'services.trustLine')} ·
        <a href={`/${lang}/trust/`}
          >{t(lang, 'services.trustLink')} <span aria-hidden="true">→</span></a
        >
      </p>
    </div>
  </div>
</section>

<style>
  .service-cta {
    padding-block: var(--space-16) var(--space-20);
  }

  .service-cta .container {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .service-cta__panel {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-10) var(--space-8);
    background: var(--bg-void);
    text-align: center;
  }

  .service-cta__heading {
    margin-bottom: var(--space-3);
  }

  .service-cta__sub {
    color: var(--text-secondary);
    max-width: 52ch;
    margin: 0 auto var(--space-8);
  }

  /* The specific promise for THIS page — sits between the generic sub and
     the button so it's the last thing read before the click, not buried
     after it. Mono + accent to read as a fact, not more marketing copy.
     :has() trims the generic sub's own bottom margin only when an outcome
     line follows it, so pages that pass nothing keep today's spacing. */
  .service-cta__panel:has(.service-cta__outcome) .service-cta__sub {
    margin-bottom: var(--space-3);
  }

  .service-cta__outcome {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-green-300);
    max-width: 52ch;
    margin: 0 auto var(--space-8);
    line-height: 1.6;
  }

  .service-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  /* The etalon's .geo-hero__cta recipe, verbatim: filled gradient pill with
     a shimmer sweep — replaces the old outline button. */
  .service-cta__primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    color: var(--bg-void);
    background: linear-gradient(135deg, var(--accent-green-300), var(--accent-green-400));
    border: 1px solid var(--accent-green-200);
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    transition:
      box-shadow 0.3s ease-out,
      border-color 0.3s ease-out;
  }

  /* Shimmer sweep — own keyframe name so it never collides with the
     geo-audit page's identically-shaped `geo-cta-shimmer-pass`. */
  .service-cta__primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      hsla(0, 0%, 100%, 0.2) 50%,
      transparent 70%
    );
    background-size: 250% 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .service-cta__primary::before {
      animation: cta-shimmer-pass 4s ease-in-out 3s infinite;
    }
  }

  @keyframes cta-shimmer-pass {
    0% {
      background-position: 200% 0;
    }
    50%,
    100% {
      background-position: -200% 0;
    }
  }

  .service-cta__primary:hover {
    box-shadow:
      0 0 20px var(--accent-glow-strong),
      0 0 60px var(--accent-glow),
      inset 0 0 20px hsla(155, 70%, 70%, 0.15);
    border-color: var(--accent-green-100);
  }

  .service-cta__email {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .service-cta__email a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .service-cta__email a:hover {
    color: var(--accent-green-300);
  }

  .service-cta__trust {
    font-size: var(--text-xs);
    color: var(--text-ghost);
    line-height: 1.8;
    margin: 0;
  }

  /* Underlined, not color-only — the a11y rule Lighthouse enforces for
     links sitting inside body text. */
  .service-cta__trust a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: var(--transition-colors);
  }

  .service-cta__trust a:hover {
    color: var(--accent-green-300);
  }

  @media (max-width: 639px) {
    .service-cta__panel {
      padding: var(--space-8) var(--space-4);
    }
  }
</style>
