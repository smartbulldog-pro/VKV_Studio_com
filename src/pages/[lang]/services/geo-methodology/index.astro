// sequence the <p> stack renders — splitting the wall into paragraphs
// therefore cannot desync the node, and that is why `body` is an array.
// Both q/a slots hold the SAME current-lang string on purpose:
// faqPageNode(lang, items) only ever reads item.q[lang]/item.a[lang], and
// copy is already lang-selected above, so this is not a missing translation —
// it is the one string this page actually renders, kept structurally
// bilingual to match FaqItem's shape.
const faqItems = copy.sections.map((s) => ({
  q: { en: s.heading, ru: s.heading },
  a: { en: s.body.join(' '), ru: s.body.join(' ') },
}));

const jsonLd = [
  techArticleNode({
    headline: copy.h1,
    description: copy.description,
    url: pageUrl,
    datePublished: '2026-08-20',
    dateModified: '2026-08-24',
    // Both were being omitted, which is precisely what techArticleNode's own
    // doc comment warns a caller not to do: without `image` the node is
    // ineligible for an Article rich result, and without `inLanguage` the two
    // locales are indistinguishable to a crawler except by URL. Article and
    // BlogPosting elsewhere on the site carry both; this was the one node
    // that did not.
    lang,
    image: `${SITE_ORIGIN}/og-geo-methodology.jpg`,
  }),
  servicesBreadcrumb(lang, copy.h1, pageUrl),
  faqPageNode(lang, faqItems),
];

// This page's mobile LCP element is the hero art, and PageHero cannot preload
// it for us: an Astro slot does not travel from a nested component up to
// BaseLayout's `head` slot (src/components/blocks/README.md — "What it does
// NOT do"). Widths must stay identical to the ones the component requests, or
// the preload is a second download: the master is 1280 wide, so the family
// resolves to exactly [768, 1280].
const HERO_WIDTHS = [768, 1280];
const heroPreloads = await Promise.all(
  HERO_WIDTHS.map((width) => getImage({ src: heroArt, format: 'avif', width }))
);
const heroImagesrcset = heroPreloads.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`).join(', ');

// Emblem art, in copy.methodEmblems order: reading (what can be shown),
// delta (what actually signals), blind (what stays unmeasured).
const methodEmblemArt = [emReading, emDelta, emBlind];

// The section that carries the delta rail — index 3, "why does a single run
// prove nothing". Named here rather than written as a bare `3` twice below.
const DELTA_SECTION = 3;
const TERMINAL_SECTION = 2;
const CHECKLIST_SECTION = 6;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  ogImage="/og-geo-methodology.jpg"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImagesrcset} imagesizes="100vw" />
  <InnerHeader lang={lang} />
  <main id="main-content" class="method-page">
    {
      /* Hero: the shared inner-page block (src/components/blocks/PageHero.astro).
         The art is a precision caliper closed on a field of glowing points —
         the ones inside the jaws sharp, the ones outside fading into a haze
         band that marks uncertainty; the page's argument in one frame. The
         plexus is born where the jaws close on the brightest point, so the
         network grows out of the single reading the instrument will stand
         behind. `scrim="center"` is this page's own composition (copy on a
         plate, focus in the middle of the frame) and matches the radial
         vignette the local hero used to declare by hand.
         The scroll hint rides to the EMBLEM strip, not past it: the three
         frames are the thesis, and the old target (#method-body) jumped the
         reader straight over them. */
    }
    <PageHero
      lang={lang}
      eyebrow={copy.eyebrow}
      title={copy.h1}
      lede={copy.lede}
      image={heroArt}
      scrim="center"
      plexus={{
        originX: 0.55,
        originY: 0.42,
        anchor: { x: 0.55, y: 0.42, width: 1280, height: 720 },
      }}
      scrollTarget="#method-emblems"
    />

    {/* ── The thesis in three frames, before a single question is read ── */}
    <section class="method-emblems-section" id="method-emblems">
      <div class="container">
        <ul class="method-emblems" role="list">
          {
            copy.methodEmblems.map((e, i) => (
              <li class="method-emblem js-method-emblem">
                <div class="method-emblem__visual" aria-hidden="true">
                  <Picture
                    src={methodEmblemArt[i]}
                    formats={['avif', 'webp']}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 639px) 90vw, (max-width: 959px) 45vw, 21rem"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                {/* The wash rises on hover/tap — the movement the old copy of
                    this tile promised in a comment and never implemented. */}
                <div class="method-emblem__glass" aria-hidden="true" />
                <div class="method-emblem__info">
                  <span class="method-emblem__label">{e.label}</span>
                  <p class="method-emblem__caption">{e.caption}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ── The seven questions ─────────────────────────────────────── */}
    <section class="method-body" id="method-body">
      <div class="container">
        {
          copy.sections.map((s, i) => (
            <article class="method-section">
              {/* Eyebrow and anchor are OUTSIDE the h2/p pair on purpose: the
                  FAQPage node is built from `heading` and `body` only, so the
                  section's navigational wiring cannot desync the JSON-LD. */}
              <p class="method-section__eyebrow text-mono js-method-reveal">
                <span aria-hidden="true">// </span>
                {s.eyebrow}
              </p>
              <h2 class="js-method-reveal">{s.heading}</h2>
              <p class="method-anchor text-mono js-method-reveal">{s.anchor}</p>
              {s.body.map((para) => (
                <p class="method-section__para js-method-reveal">{para}</p>
              ))}

              {
                /* Section 03 (audit scope): the same terminal-window idiom the
                   audit page's own terms use — "on paper" rendered literally.
                   No reveal hook on the window itself: its lines carry the
                   entrance, and nesting one reveal inside another multiplied
                   the two opacities and made the block fade in twice. */
                i === TERMINAL_SECTION && (
                  <div class="method-terminal">
                    <div class="method-terminal__bar text-mono" aria-hidden="true">
                      <span class="method-terminal__dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span>{copy.processTerminal.path}</span>
                    </div>
                    <ul class="method-terminal__lines">
                      {copy.processTerminal.lines.map((line) => (
                        <li class="js-method-term-line">{line}</li>
                      ))}
                    </ul>
                  </div>
                )
              }

              {
                /* Section 04 (one run against two): the delta rail. The line
                   between the two readings is drawn by the scroll position
                   itself — the only scrub on this page, and the one place
                   where a scrub illustrates the argument instead of
                   decorating it. Decorative: the paragraphs above already
                   carry the whole statement in words. */
                i === DELTA_SECTION && (
                  <div class="method-delta" aria-hidden="true">
                    <div class="method-delta__rail">
                      <span class="method-delta__track" />
                      <span class="method-delta__line js-method-delta-line" />
                      <span class="method-delta__dot js-method-delta-dot" data-at="start" />
                      <span class="method-delta__dot js-method-delta-dot" data-at="end" />
                    </div>
                    <ol class="method-delta__marks">
                      {copy.deltaMarks.map((mark) => (
                        <li class="text-mono">{mark}</li>
                      ))}
                    </ol>
                  </div>
                )
              }

              {
                /* Section 07 (before you buy): the five questions as a
                   numbered checklist a buyer can actually take into a vendor
                   call. */
                i === CHECKLIST_SECTION && (
                  <ol class="method-checklist">
                    {copy.checklistItems.map((item) => (
                      <li class="js-method-item">{item}</li>
                    ))}
                  </ol>
                )
              }
            </article>
          ))
        }

        {
          /* Outside the FAQ loop on purpose (see the file header comment):
             this is where the two required links live, kept out of the
             FAQPage text so the JSON-LD stays a plain-text match for the
             questions above. */
        }
        <blockquote class="method-callout js-method-reveal">
          <p class="method-callout__label text-mono">
            <span aria-hidden="true">// </span>{copy.calloutLabel}
          </p>
          <p class="method-callout__text">{copy.calloutBody}</p>
          <div class="method-callout__links">
            <a href={`/${lang}/services/geo-audit/`}>
              {copy.calloutAuditCta}
              <span aria-hidden="true">→</span>
            </a>
            <a href={`/${lang}/trust/`}>
              {copy.calloutTrustCta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </blockquote>
      </div>
    </section>

    <ServiceCta lang={lang} outcome={t(lang, 'services.ctaOutcomes.geoMethodology')} />
  </main>
</BaseLayout>

<script>
  // Homepage manners on this page too (owner: they are the site norm) —
  // Lenis smooths the wheel; under reduced motion initLenis() is a no-op.
  // The hero's own scroll hint and video gate live inside PageHero.
  import { initLenis } from '@scripts/lenis-init';

  // Motion is an enhancement, never a gatekeeper: nothing here starts hidden
  // in CSS, so a failed import or an old browser sees a complete page.
  // gsap.from() does the hide-then-reveal itself, and clearProps hands each
  // element back to the stylesheet once its tween lands.
  //
  // Every value below comes from the site's motion dictionary
  // (.system/canon/10-motion.md §4.3/§4.4). The previous version of this file
  // invented its own — y:20 / 0.6 / power2.out on a `top 90%` threshold, one
  // trigger per tile in a single row — which is the literal recipe for the
  // owner's verdict "static movement": three tiles in one row all fired in
  // the same frame, at the very edge of the viewport, over a distance too
  // small to register.
  async function initMethodMotion(): Promise<void> {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Hero lede cursor parallax — the homepage/geo-audit hero's manners
    // (geo-audit/index.astro:1019–1065), minus the magnetic CTA: PageHero's
    // markup here carries no CTA for the cursor to lean toward, only the
    // lede. Already covered by the reduced-motion gate above; the extra
    // (hover: hover) and (pointer: fine) gate keeps it off touch and coarse
    // pointers, and the listener is passive since it only ever reads the
    // event.
    const hero = document.querySelector<HTMLElement>('.page-hero');
    const lede = hero?.querySelector<HTMLElement>('.page-hero__lede');
    if (hero && lede && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      hero.addEventListener(
        'mousemove',
        (e) => {
          const rect = hero.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          lede.style.transform = `translate(${(x - 0.5) * -3}px, ${(y - 0.5) * -2}px)`;
        },
        { passive: true }
      );
      hero.addEventListener('mouseleave', () => {
        lede.style.transform = '';
      });
    }

    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      // Section wiring reveals PER ELEMENT — eyebrow, heading, anchor and
      // each paragraph on its own trigger, the etalon's cascade
      // (geo-audit/index.astro:637–650). Revealing the whole <article> as one
      // body moved half a screen of text by 24px, which reads as nothing.
      document.querySelectorAll<HTMLElement>('.js-method-reveal').forEach((el) => {
        gsap.from(el, {
          opacity: 0,
          y: 24,
          duration: 0.7,
          ease: 'power2.out',
          clearProps: 'all',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
      });

      // The three emblems are a GRID OF EQUAL TILES, so the dictionary says:
      // one trigger on the container, one wave, stagger 0.08, 0.7 expo.out
      // from y:40 + scale:0.9 (canon §4.3 rows "card entrance" and "stagger",
      // §4.4 "grid of equal tiles → top 80%"; sample geo-audit:701–714).
      const emblems = document.querySelectorAll<HTMLElement>('.js-method-emblem');
      if (emblems.length > 0) {
        gsap.fromTo(
          emblems,
          { opacity: 0, y: 40, scale: 0.9 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.7,
            stagger: 0.08,
            ease: 'expo.out',
            clearProps: 'all',
            scrollTrigger: { trigger: '.method-emblems', start: 'top 80%' },
          }
        );
      }

      // Checklist rows: quiet per-item reveals (geo-audit's .js-geo-item).
      document.querySelectorAll<HTMLElement>('.js-method-item').forEach((el) => {
        gsap.from(el, {
          opacity: 0,
          y: 18,
          duration: 0.5,
          ease: 'power2.out',
          clearProps: 'all',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });

      // Terminal lines: type-in stagger, the audit page's own idiom, on the
      // audit page's own threshold (top 75%). At `top 85%` the typing was
      // already finished by the time the window was readable.
      gsap.from('.js-method-term-line', {
        opacity: 0,
        x: -16,
        duration: 0.45,
        ease: 'power2.out',
        stagger: 0.22,
        clearProps: 'all',
        scrollTrigger: { trigger: '.method-terminal', start: 'top 75%' },
      });

      // The delta rail: the page's only scrub. `ease: 'none'` is mandatory —
      // any other curve breaks the 1:1 tie between scroll position and
      // animation position (canon §4.3 rule 5). The line is the delta; the
      // two dots are the readings, springing in as they are reached.
      const deltaLine = document.querySelector<HTMLElement>('.js-method-delta-line');
      if (deltaLine) {
        gsap.fromTo(
          deltaLine,
          { scaleY: 0 },
          {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: '.method-delta',
              start: 'top 75%',
              end: 'bottom 60%',
              scrub: 0.8,
            },
          }
        );

        document.querySelectorAll<HTMLElement>('.js-method-delta-dot').forEach((dot) => {
          gsap.from(dot, {
            scale: 0,
            duration: 0.6,
            ease: 'back.out(2.5)',
            clearProps: 'all',
            scrollTrigger: { trigger: dot, start: 'top 90%' },
          });
        });
      }
    } catch (err) {
      // No rescue pass needed — content was never hidden.
      console.error('[geo-methodology] motion failed to load:', err);
    }
  }

  /**
   * Emblem tiles on a coarse pointer. `:hover` alone left them completely
   * dead on a phone — no way to reach the state at all — and mobile Safari's
   * synthetic hover sticks without a matching leave. A tap toggles `.is-open`
   * with a singleton (never more than one open), which is the site's
   * established gesture for this tile family (section-animations.ts:500–534).
   * The caption stays legible in BOTH states here, unlike the audit page's
   * retainer cards, so nothing is hidden behind the gesture.
   */
  function initMethodEmblemTaps(): void {
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const tiles = Array.from(document.querySelectorAll<HTMLElement>('.js-method-emblem'));
    if (tiles.length === 0) return;

    for (const tile of tiles) {
      tile.addEventListener('click', () => {
        const wasOpen = tile.classList.contains('is-open');
        for (const other of tiles) other.classList.remove('is-open');
        if (!wasOpen) tile.classList.add('is-open');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLenis();
      void initMethodMotion();
      initMethodEmblemTaps();
    });
  } else {
    initLenis();
    void initMethodMotion();
    initMethodEmblemTaps();
  }
</script>

<style>
  /* The page frame stays on the page: PageHero computes its own height
     reserve from these same tokens (see blocks/README.md — "No page frame"),
     so changing the padding here without changing the component desyncs them. */
  .method-page {
    padding-top: var(--space-10);
    min-height: 100vh;
    background: var(--bg-obsidian);
  }

  @media (max-width: 767px) {
    .method-page {
      padding-top: var(--space-4);
    }
  }

  /* ── The seven questions ─────────────────────────────────────── */
  .method-body {
    margin-bottom: var(--space-8);
  }

  /* Left-railed on the wide container: the readability cap lives on this
     text wrapper, same idiom as the etalon's .geo-callout / .geo-terms-window. */
  .method-section {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-10);
  }

  /* Same recipe as the etalon's .geo-section__eyebrow: size and colour come
     from .text-mono, only the margin is owned here. */
  .method-section__eyebrow {
    margin-bottom: var(--space-4);
  }

  .method-section h2 {
    font-size: var(--text-h1);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  /* The etalon's .geo-anchor — one green summary line under the heading, so
     seven sections can be scanned without reading them. */
  .method-anchor {
    font-size: var(--text-sm);
    color: var(--accent-green-300);
    max-width: 62ch;
    margin-bottom: var(--space-6);
  }

  .method-section__para {
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 var(--space-5);
  }

  .method-section__para:last-of-type {
    margin-bottom: 0;
  }

  /* ── The three emblems — the page's thesis before a single question is
     read. Same recipe as the Stack tiles (image, glass, info) and the audit
     page's retainer cards, authored locally since it is a shared visual
     language, not a shared class: obsidian ground, one glowing object, the
     label on a rising glass wash. ───────────────────────────────────── */
  .method-emblems-section {
    padding-block: var(--space-10) var(--space-4);
  }

  .method-emblems {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
    max-width: 64rem;
    margin: 0 auto;
    padding: 0;
  }

  .method-emblem {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-shadow);
    transition:
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .method-emblem:hover,
  .method-emblem.is-open {
    border-color: var(--accent-green-300);
    box-shadow: var(--glass-shadow), var(--glow-green);
  }

  .method-emblem__visual {
    position: absolute;
    inset: 0;
  }

  .method-emblem__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform var(--duration-slow) var(--ease-out),
      filter var(--duration-slow) var(--ease-out);
  }

  .method-emblem:hover .method-emblem__visual :global(img),
  .method-emblem.is-open .method-emblem__visual :global(img) {
    filter: brightness(1.12);
  }

  /* Scale gated per the house motion rule (swarm audit 2026-09-06) — and
     is-open fires on tap, so an ungated transform here moved things for
     touch users who asked the OS for reduced motion. Brightness stays for
     everyone: a tint is feedback, not motion. */
  @media (prefers-reduced-motion: no-preference) {
    .method-emblem:hover .method-emblem__visual :global(img),
    .method-emblem.is-open .method-emblem__visual :global(img) {
      transform: scale(1.05);
    }
  }

  /* The wash actually rises now. At rest it sits low, so the emblem reads as
     an object on obsidian; on hover or tap it climbs and the caption gets its
     surface. The comment above this block promised exactly this and the
     shipped rule was a static gradient — that gap is half of the owner's
     "статичное движение". Transform only: no repaint, no layout. */
  .method-emblem__glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      hsla(220, 24%, 6%, 0.92) 0%,
      hsla(220, 24%, 6%, 0.35) 50%,
      transparent 100%
    );
    transform: translateY(18%);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .method-emblem:hover .method-emblem__glass,
  .method-emblem.is-open .method-emblem__glass {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .method-emblem__glass {
      /* The state still exists, it just arrives instantly — a reduced-motion
         reader gets the same information, never a dead control. */
      transition: none;
    }

    .method-emblem__visual :global(img) {
      transition: none;
    }
  }

  .method-emblem__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-5);
  }

  .method-emblem__label {
    display: block;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .method-emblem__caption {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Terminal window (section 03) — the audit page's "on paper" idiom,
     authored locally for the same reason as the tiles above. ──────────── */
  .method-terminal {
    position: relative;
    max-width: 56rem;
    margin-top: var(--space-6);
    border: 1px solid hsla(0, 0%, 100%, 0.06);
    border-radius: var(--radius-lg);
    background: hsla(220, 20%, 10%, 0.75);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.05);
    overflow: hidden;
  }

  /* The standard property, restated where the CSS minifier cannot rewrite it
     away: in the built bundle it collapses `backdrop-filter` into the -webkit-
     alias alone, and Firefox (standard-only) then renders a flat fill. The
     minifier does not merge across an @supports boundary, so this copy ships.
     Must stay AFTER the base rule — equal specificity, last one wins.
     Same idiom as .glass-panel / .hero-plate in src/styles/global.css. */
  @supports (backdrop-filter: blur(1px)) {
    .method-terminal {
      backdrop-filter: blur(14px) saturate(140%);
    }
  }

  .method-terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.06);
    font-size: var(--text-xs);
    color: var(--text-ghost);
    letter-spacing: var(--tracking-wide);
  }

  .method-terminal__dots {
    display: inline-flex;
    gap: 6px;
  }

  .method-terminal__dots i {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: hsla(0, 0%, 100%, 0.12);
  }

  .method-terminal__dots i:first-child {
    background: hsla(155, 65%, 50%, 0.45);
  }

  .method-terminal__lines {
    list-style: none;
    padding: var(--space-5) var(--space-5) var(--space-6);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .method-terminal__lines li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .method-terminal__lines li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--accent-green-400);
