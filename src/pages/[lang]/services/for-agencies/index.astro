          title: 'RAG-ассистенты',
          body: 'Для клиентов, которым нужен ассистент на собственных документах.',
        },
        {
          title: 'Self-hosted AI-развёртывания',
          body: 'Для клиентов, которым сторонний SaaS не подходит по комплаенсу.',
        },
      ],
      outro:
        'Каждый результат приходит без брендинга — без водяного знака, без подписи — оформленный под ваш собственный шаблон.',
    },
    runs: {
      heading: 'Как устроено взаимодействие',
      body: 'Отношения с клиентом — от первого контакта до последнего счёта — полностью ваши; я не выхожу на связь с вашим клиентом без вашего письменного разрешения, а если и выхожу — то только в той роли, в которой вы меня представите. NDA в обе стороны подписывается до того, как начнёт двигаться хоть один бриф.',
      quoteLabel: 'обещание',
      quote: 'Ваш клиент не узнает о моём существовании — если вы сами не решите это раскрыть.',
      bodyEnd:
        'Срок, который вы пообещали клиенту, устанавливаете вы; срок, который я пообещал вам, соблюдаю я.',
    },
    costsHeading: 'Сколько это стоит',
    costsIntroPre:
      'Отдельного оптового прайс-листа нет, как и придуманной агентской скидки: вы платите ',
    costsLinkLabel: 'те же опубликованные цены, что и на открытой лестнице услуг',
    costsIntroPost: ', пакет за пакетом.',
    costsFacts: [
      { label: 'Фиксированная цена', value: 'Аудит, пилот.' },
      { label: 'Диапазон или порог', value: 'Сайт, self-hosted развёртывание.' },
    ],
    costsOutro:
      'Я выставляю счёт напрямую вам, а не вашему клиенту, — по тому же графику оплаты по этапам, что и на каждой ступени лестницы, — обычно 30/40/30; что и когда вы выставляете своему клиенту — целиком ваше решение. Ваша наценка сверху — целиком ваш выбор: я никогда не называю вашему клиенту цифру и никогда не вижу цифру, которую называете вы, а значит, на переговорах никогда не появится конкурирующая цифра.',
    notDo: {
      heading: 'Чего я не буду делать',
      items: [
        'Я не буду предлагать вашему клиенту работать со мной напрямую — ни во время проекта, ни после его завершения.',
        'Я не буду выходить на связь с вашим клиентом без вашего письменного разрешения — даже чтобы просто поздороваться.',
        'Я не подпишу условие эксклюзивности, которое закроет студию для других агентств: между проектами мне нужен собственный поток заказов, а эксклюзив, который его перекрывает, не помогает никому из нас.',
      ],
    },
    logistics: {
      heading: 'Логистика, которая реально важна',
      facts: [
        {
          label: 'Часовой пояс',
          value:
            'GMT+4 — вторая половина моего рабочего дня совпадает с вашим утром в ЕС и Великобритании: реальное окно пересечения каждый рабочий день, прежде чем что-либо приходится откладывать на завтра.',
        },
        {
          label: 'Процесс',
          value:
            'Асинхронный — брифы и результаты работы передаются документами, ответ приходит письменно в течение одного рабочего дня, а звонки случаются, когда действительно заслуживают места в расписании.',
        },
        {
          label: 'Бумага',
          value:
            'Всё оформляется договором; счета выставляются без VAT — вы самостоятельно учитываете его по механизму reverse charge.',
        },
      ],
    },
    start: {
      heading: 'Как начать',
      steps: [
        {
          num: '01',
          title: 'Отправьте бриф',
          body: 'Один текущий бриф клиента — можно обезличенный.',
        },
        {
          num: '02',
          title: 'Получите смету',
          body: 'Письменный ответ в течение одного рабочего дня, как и на любой другой канал на этом сайте; фиксированная смета со сроком сдачи — в течение двух рабочих дней.',
        },
        {
          num: '03',
          title: 'Начните с малого',
          body: 'Первый проект стоит намеренно сделать небольшим: один аудит, один сайт. Пусть процесс покажет себя в деле, прежде чем вы поставите его на поток в агентстве.',
        },
      ],
    },
    linksPre: 'Полный список цен — на странице ',
    linksLadder: 'лестницы услуг',
    linksMid: ', а условия договора, которые обещает эта страница, целиком расписаны на странице ',
    linksTrust: '«Доверие и процесс»',
    linksPost: '.',
  },
}[lang];

// The hero art is this page's mobile LCP element (etalon pattern). The
// master is a 1280px still, so the preload/srcset widths stop at 1280.
const HERO_WIDTHS = [768, 1280];
const heroPreloads = await Promise.all(
  HERO_WIDTHS.map((width) => getImage({ src: heroArt, format: 'avif', width }))
);
const heroImagesrcset = heroPreloads.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`).join(', ');

const pageUrl = `${SITE_ORIGIN}/${lang}/services/for-agencies/`;
const jsonLd = [servicesBreadcrumb(lang, copy.h1, pageUrl), faqPageNode(lang, AGENCY_FAQ)];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  jsonLd={jsonLd}
  ogImage="/og-for-agencies.jpg"
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImagesrcset} imagesizes="100vw" />
  <InnerHeader lang={lang} />
  <main id="main-content" class="agency-page">
    {
      /* ── Hero: the shared block. Five page-specific values, nothing else.
         Art generated in-house (ComfyUI): two overlapping picture frames, the
         front one carrying a blank lit nameplate, the one behind it dimmed —
         the work carries YOUR name; mine stays off the plate. `scrim="left"`
         keeps the darkening on the side the old hand-written pair darkened,
         now at the canonical stops. `plexus` is born at the nameplate, the
         front frame's own light source, low-centre where a plaque reads;
         the anchor pins it there through every crop `object-fit: cover`
         performs, against the master's own 1280×720 frame. No hero video on
         this page yet (ComfyUI production, owner's call), so the still simply
         breathes. */
    }
    <PageHero
      lang={lang}
      eyebrow={copy.eyebrow}
      title={copy.h1}
      lede={copy.lede}
      image={heroArt}
      scrim="left"
      plexus={{
        originX: 0.5,
        originY: 0.64,
        anchor: { x: 0.5, y: 0.64, width: 1280, height: 720 },
      }}
      scrollTarget="#agency-body"
    />

    <section class="agency-body" id="agency-body">
      <div class="container">
        {
          /* What you buy: the run-on sentence in the previous draft became a
             numbered tile grid, one clause per tile, wording preserved —
             this is the block the owner named as the clearest wall of text
             on the page. */
        }
        <article class="agency-section agency-section--wide">
          {
            /* Reveal sits on the LINES, never on the article that also holds
               the tile grid: a container tween multiplied into the tiles' own
               tween made them fade twice and travel up to 64px (F1 of the gap
               report). The etalon animates elements, never a container over
               its own content (geo-audit:637–650). */
          }
          <h2 class="js-agency-reveal">{copy.buy.heading}</h2>
          <p class="agency-section__intro js-agency-reveal">{copy.buy.intro}</p>
          <ul class="agency-tiles" role="list">
            {
              copy.buy.items.map((item, i) => (
                <li class="agency-tile js-agency-tile">
                  <span class="agency-tile__num text-mono" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="agency-tile__title">{item.title}</h3>
                  <p class="agency-tile__body">{item.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="agency-section__outro js-agency-reveal">{copy.buy.outro}</p>
        </article>

        {
          /* How the engagement runs: the strongest single-sentence promise
             ("your client never learns I exist") is pulled out as a
             pull-quote — the etalon's own device for breaking up a
             paragraph without cutting a fact. */
        }
        <article class="agency-section js-agency-reveal">
          <h2>{copy.runs.heading}</h2>
          <p>{copy.runs.body}</p>
          <blockquote class="agency-quote">
            <p class="agency-quote__label text-mono">
              <span aria-hidden="true">// </span>{copy.runs.quoteLabel}
            </p>
            <p class="agency-quote__text">{copy.runs.quote}</p>
          </blockquote>
          <p>{copy.runs.bodyEnd}</p>
        </article>

        {
          /* Costs: its own block, not folded into a generic loop, so the
             ladder link sits right where the cost question is asked. Still
             no EUR/GBP figure printed here (standing rule, see file
             header): the link and the fixed/range distinction — now a
             two-column fact pair — are the answer, not a second price
             list. */
        }
        <article class="agency-section js-agency-reveal">
          <h2>{copy.costsHeading}</h2>
          <p>
            {copy.costsIntroPre}<a href={`/${lang}/services/`}>{copy.costsLinkLabel}</a>{
              copy.costsIntroPost
            }
          </p>
          <dl class="agency-facts">
            {
              copy.costsFacts.map((f) => (
                <div class="agency-facts__row">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <p>{copy.costsOutro}</p>
        </article>

        {
          /* What I will not do: three promises, one per line — a dash list
             reads as a set of guarantees, not a paragraph making excuses. */
        }
        <article class="agency-section js-agency-reveal">
          <h2>{copy.notDo.heading}</h2>
          {
            /* role="list" for the same reason the buy grid carries it: the
             global `list-style: none` reset drops list semantics in
             Safari/VoiceOver. */
          }
          <ul class="agency-not-list" role="list">
            {copy.notDo.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        {
          /* Logistics: timezone / process / paper as a definition list —
             the two-column facts idiom, same shape as the etalon's terms
             windows and retainer cards. */
        }
        <article class="agency-section js-agency-reveal">
          <h2>{copy.logistics.heading}</h2>
          <dl class="agency-facts">
            {
              copy.logistics.facts.map((f) => (
                <div class="agency-facts__row">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </article>

        {
          /* How to start: the geo-audit process-step idiom (num, title,
             body), minus the scroll-driven connecting line — three steps
             don't need one. */
        }
        <article class="agency-section agency-section--wide">
          {
            /* Same untangling as the buy grid: the heading reveals, the steps
             ride their own grid tween. */
          }
          <h2 class="js-agency-reveal">{copy.start.heading}</h2>
          <ol class="agency-steps" role="list">
            {
              copy.start.steps.map((s) => (
                <li class="agency-step js-agency-tile">
                  <span class="agency-step__num text-mono" aria-hidden="true">
                    {s.num}
                  </span>
                  <h3 class="agency-step__title">{s.title}</h3>
                  <p class="agency-step__body">{s.body}</p>
                </li>
              ))
            }
          </ol>
        </article>

        <p class="agency-links js-agency-reveal">
          {copy.linksPre}<a href={`/${lang}/services/`}>{copy.linksLadder}</a>{copy.linksMid}<a
            href={`/${lang}/trust/`}>{copy.linksTrust}</a
          >{copy.linksPost}
        </p>
      </div>
    </section>

    <FaqSection lang={lang} items={AGENCY_FAQ} id="agency-faq" />

    <ServiceCta lang={lang} />
  </main>
</BaseLayout>

<script>
  // The homepage's scroll engine + the etalon's motion grammar. Motion is an
  // enhancement, never a gatekeeper: nothing on this page starts hidden in
  // CSS, so a failed import or an old browser sees a complete page.
  import { initLenis } from '@scripts/lenis-init';

  async function initAgencyMotion(): Promise<void> {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      document.querySelectorAll<HTMLElement>('.js-agency-reveal').forEach((el) => {
        const tw = gsap.from(el, {
          opacity: 0,
          y: 24,
          duration: 0.7,
          ease: 'power2.out',
          clearProps: 'all',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
        // A keyboard user tabbing in before the trigger fires must not land
        // on an invisible link (the links row carries real ones).
        el.addEventListener('focusin', () => tw.progress(1), { once: true });
      });

      // Tile/step grids: the canonical grid wave (geo-audit:700–714) —
      // y 40 / scale 0.9 / 0.7s / stagger 0.08 / 'top 80%', one trigger per
      // grid so each row cascades in as it actually enters. The buy grid and
      // the how-to-start steps both use this class; neither sits inside a
      // revealing container any more, so a tile fades exactly once.
      const tileGrids = new Set<Element>();
      document.querySelectorAll<HTMLElement>('.js-agency-tile').forEach((el) => {
        const grid = el.parentElement;
        if (grid) tileGrids.add(grid);
      });
      tileGrids.forEach((grid) => {
        gsap.fromTo(
          grid.querySelectorAll('.js-agency-tile'),
          { opacity: 0, y: 40, scale: 0.9 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.7,
            stagger: 0.08,
            ease: 'expo.out',
            clearProps: 'all',
            scrollTrigger: { trigger: grid, start: 'top 80%' },
          }
        );
      });
    } catch (err) {
      // No rescue pass needed — content was never hidden.
      console.error('[for-agencies] motion failed to load:', err);
    }
  }

  // The scroll hint and the hero's own manners moved into PageHero with the
  // hero itself: the component owns the button, rides Lenis when this page has
  // started it (it does, below), and falls back to an honest instant jump
  // under reduced motion. The hand-written twins that used to live here are
  // gone rather than left running against markup that no longer exists.
  // The lede parallax went with them — PageHero deliberately has no knob for
  // it (blocks/README.md, "What it does NOT do"); flagged for the owner.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLenis();
      void initAgencyMotion();
    });
  } else {
    initLenis();
    void initAgencyMotion();
  }
</script>

