---
/**
 * /services/for-agencies/ — the white-label pitch. Highest-leverage channel
 * on the site (an agency brings traffic, trust and case studies at once),
 * and previously the thinnest page. Shared hero + full dramaturgy now:
 * what an agency buys → how the engagement runs → what it costs → what I
 * will not do → logistics → how to start → FAQ.
 *
 * The hero is the shared `PageHero` block (`src/components/blocks/`), not a
 * hand-typed copy: plate, eyebrow pill, letter-split h1, scroll hint, the
 * entrance cascade and the mobile scroll-hint fix all live there once. This
 * page passes only what is genuinely its own — the copy, its ComfyUI still,
 * the scrim direction, the plexus birth point, the scroll target. Three
 * numeric drifts measured in `.system/gaps/gap-websites-agencies.md`
 * (F10 h1 metric, F11 art breathing, F13 scrim stops) and two missing
 * safeguards (F15 safe-area, the un-gated `will-change`) are answered by the
 * move itself, because the component carries the canonical values.
 *
 * Standing rule (kept from the prior draft, still true): no EUR/GBP figures
 * on this page — "the same fixed prices published on the service ladder" is
 * the formula, so a reader always follows the link to the real numbers
 * rather than reading a second, driftable price list here.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import InnerHeader from '@components/layout/InnerHeader.astro';
import PageHero from '@components/blocks/PageHero.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import ServiceCta from '@components/services/ServiceCta.astro';
import heroArt from '@/assets/services/rung2-agencies.png';
import { SITE_ORIGIN } from '@/data/services';
import { faqPageNode, servicesBreadcrumb } from '@/lib/services-jsonld';
import type { FaqItem } from '@/data/faq';
import { supportedLangs } from '@i18n/utils';
import type { Lang } from '@i18n/utils';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

// This page's own mini-FAQ (no services-faq.ts entry for a non-rung page —
// same pattern as contact/index.astro's inline CONTACT_FAQ, wired into
// faqPageNode below so the visible text and the FAQPage markup match
// verbatim).
const AGENCY_FAQ: FaqItem[] = [
  {
    q: {
      en: 'Will my client ever find out you were involved?',
      ru: 'Узнает ли мой клиент о моём участии?',
    },
    a: {
      en: 'Only if you decide to tell them. Every deliverable arrives unbranded — no watermark, no signature, formatted to drop into your own template — and I never contact your client on my own initiative, before, during or after the work.',
      ru: 'Только если вы сами решите об этом сказать. Каждый результат приходит без брендинга — без водяного знака, без подписи, оформленный под ваш шаблон, — и я никогда не выхожу на связь с вашим клиентом по своей инициативе: ни до работы, ни во время, ни после.',
    },
  },
  {
    q: {
      en: 'Is the pricing different from your public rates?',
      ru: 'Цены отличаются от тех, что указаны на сайте?',
    },
    a: {
      en: "No — the same published prices as the public service ladder, package for package: fixed where the ladder is fixed (the audit, the pilot), the same range or floor where it is one (the site build, the self-hosted deployment). I don't quote your client a competing number, because I never quote your client at all; the margin you add on top is entirely yours to set.",
      ru: 'Нет — те же опубликованные цены, что и на открытой лестнице услуг, пакет за пакетом: фиксированные там, где фиксирована сама лестница (аудит, пилот), и тот же диапазон или порог там, где это диапазон или порог (сайт, self-hosted развёртывание). Я никогда не называю вашему клиенту цифру напрямую, потому что вообще не называю клиенту цифру, — наценку сверху вы устанавливаете сами.',
    },
  },
  {
    q: {
      en: 'What if my client asks to speak with the engineer directly?',
      ru: 'Что, если клиент попросит поговорить с инженером напрямую?',
    },
    a: {
      en: 'That request goes through you, not around you. I join a call only if you invite me in, and I follow whatever introduction you give me — as your consultant, your engineer, or not named at all.',
      ru: 'Такой запрос идёт через вас, а не в обход вас. Я подключаюсь к звонку только по вашему приглашению и следую той роли, в которой вы меня представите: как ваш консультант, ваш инженер — или вовсе без имени.',
    },
  },
  {
    q: {
      en: 'What stops you from approaching my client later?',
      ru: 'Что мешает вам выйти на моего клиента позже?',
    },
    a: {
      en: 'The NDA runs both ways and survives the engagement, and it is simply not the business I am building: the studio grows through direct clients and other agencies, not by prospecting the accounts I reach through yours. Putting that in writing costs me nothing and gives you something to hold me to.',
      ru: 'NDA действует в обе стороны и не заканчивается вместе с проектом, и это попросту не та модель, которую я строю: студия растёт за счёт прямых клиентов и других агентств, а не за счёт переманивания клиентов, с которыми меня познакомили вы. Написать это прямо мне ничего не стоит, а вам даёт документ, которым меня можно держать за слово.',
    },
  },
];

const copy = {
  en: {
    title: 'White-Label Engineering for Agencies | VKVstudio',
    description:
      "White-label GEO audits, Astro builds and RAG assistants delivered under your agency's brand — the same published prices as on the public service ladder, NDA both ways, and no contact with your client without your written go-ahead.",
