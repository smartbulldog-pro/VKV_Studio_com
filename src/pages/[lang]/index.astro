---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/layout/Header.astro';
import HeroCanvas from '@components/sections/HeroCanvas.astro';
import AboutSection from '@components/sections/AboutSection.astro';
import LabSection from '@components/sections/LabSection.astro';
import StackSection from '@components/sections/StackSection.astro';
import ContactSection from '@components/sections/ContactSection.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import VKVLogo from '@components/ui/VKVLogo.svelte';
import SynapseApp from '@components/ui/SynapseApp.svelte';
import NeuralWaypoints from '@components/ui/NeuralWaypoints.svelte';
import ConstellationNav from '@components/ui/ConstellationNav.svelte';
import { supportedLangs } from '@i18n/utils';
import { FAQ } from '@/data/faq';
import type { Lang } from '@i18n/utils';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return supportedLangs.map((lang) => ({
    params: { lang },
  }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

// FAQPage lives HERE and only here — on the one page that actually renders
// these questions and answers. It used to sit in BaseLayout and therefore on
// all 12 pages, none of which showed the text; the privacy policy was carrying
// "Can I hire Valerii?" in its structured data. Built from the same FAQ array
// the visible section maps over, so the two cannot drift apart.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: item.a[lang] },
  })),
};
---

<BaseLayout lang={lang} jsonLd={[faqJsonLd]}>
  {
    /*
    Phase 1.7 Navigation Revolution:
    - Header: only MenuPill (three dots) — dispatches vkv:constellation-toggle event
    - ConstellationNav: fullscreen overlay, self-contained (listens to window event)
    - VKVLogo: scroll journey (hero → fade → career arc → fixed pill)
    - SynapseBrain: bottom-right video scrub (brain → synapse morph)
    - NeuralWaypoints: right-side vertical navigation dots
  */
  }
  <Header lang={lang} />

  {/* ConstellationNav — fullscreen overlay triggered by MenuPill */}
  <ConstellationNav lang={lang} client:idle />

  {/* VKV Logo — manages its own fixed/absolute positioning */}
  <VKVLogo lang={lang} client:idle />

  <main id="main-content">
    <HeroCanvas lang={lang} />
    <AboutSection lang={lang} />
    <LabSection lang={lang} />
    <StackSection lang={lang} />
    <FaqSection lang={lang} />
    <ContactSection lang={lang} />
  </main>

  {/* Neural Waypoints — right-side vertical navigation (hidden on mobile) */}
  <NeuralWaypoints lang={lang} client:visible />

  {/* Synapse App — brain trigger + terminal overlay */}
  <SynapseApp client:idle lang={lang} />
</BaseLayout>

<script>
  // Dynamic import so a failed chunk fetch (flaky mobile network) degrades to
  // "content visible, no animation" instead of "sections invisible forever":
  // About/Lab/Stack/Contact all start at opacity:0 and only the animation
  // module reveals them. The rescue selector list mirrors disableAnimations()
  // in section-animations.ts — keep the two in sync (it can't be imported
  // here: the whole point is that the import may have failed).
  async function startSectionAnimations() {
    try {
      const { initSectionAnimations } = await import('@scripts/section-animations');
      initSectionAnimations();
    } catch (err) {
      console.error('[index] section-animations chunk failed to load:', err);
      document
        .querySelectorAll<HTMLElement>(
          '.js-about-reveal, .js-timeline-item, .js-timeline-dot, .js-timeline-card, .js-timeline-line, .js-lab-header, .js-lab-card, .lab__card-visual, .lab__card-content, .lab__card-cta, .js-stack-header, .js-stack-card, .js-stack-glass, .js-contact-reveal'
        )
        .forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
          el.style.filter = 'none';
        });
    }
  }

  // Initialize after DOM is ready (Lenis already started in HeroCanvas)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => void startSectionAnimations());
  } else {
    void startSectionAnimations();
  }
</script>
