---
/**
 * /contact/ — the funnel. Twenty pages already point here ("Start a
 * conversation"), and the site FAQ promises "four short questions" — this
 * page IS that promise. Written-first by design: the deliverable of the
 * form is a written reply from the engineer within one business day; the
 * 30-minute call is the optional second door (Cal.com link-out, never an
 * embed — CSP and the Lighthouse-100 budget both say no third-party
 * scripts).
 *
 * The form has no backend on purpose (CSP form-action 'none'): answers
 * become a prefilled email in the visitor's OWN mail client. Nothing is
 * collected, nothing can leak — stated on the page, because for a buyer
 * being sold "your data never leaves your infrastructure", a contact form
 * that provably cannot leak is proof of worldview, not a limitation.
 */
import { Image, Picture, getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import InnerHeader from '@components/layout/InnerHeader.astro';
import NeuralPlexus from '@components/ui/NeuralPlexus.svelte';
import FaqSection from '@components/sections/FaqSection.astro';
import ContactFunnel from '@components/contact/ContactFunnel.svelte';
import portrait from '@/assets/people/valerii-lens.png';
import heroArt from '@/assets/contact/contact-hero.png';
import { CAL_BOOKING_URL, CONTACT_EMAIL } from '@/lib/site-config';
import { SITE_ORIGIN } from '@/data/services';
import { breadcrumbNode, faqPageNode } from '@/lib/services-jsonld';
import type { FaqItem } from '@/data/faq';
import { supportedLangs, t } from '@i18n/utils';
import type { Lang } from '@i18n/utils';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const { lang } = Astro.params as { lang: Lang };

// This page's own mini-FAQ (Princeton GEO: FAQPage markup on a page that
// already answers these questions measurably lifts AI-citation odds). No
// aggregateRating, ever — see services-jsonld.ts's house rule.
