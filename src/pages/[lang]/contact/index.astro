// The hero art is this page's mobile LCP element. The master is a 1280px
// still (checked against the PNG's own IHDR), so the preload/srcset widths
// stop at 1280 — requesting 1920 from a 1280 master silently clamps and
// duplicates the 1280 URL (etalon: services/index.astro).
const heroPreloads = await Promise.all(
  [768, 1280].map((width) => getImage({ src: heroArt, format: 'avif', width }))
);
const heroImagesrcset = heroPreloads.map((img, i) => `${img.src} ${[768, 1280][i]}w`).join(', ');

const pageUrl = `${SITE_ORIGIN}/${lang}/contact/`;
const jsonLd = [
  breadcrumbNode(lang, [
    { name: t(lang, 'nav.home'), item: `${SITE_ORIGIN}/${lang}/` },
    { name: t(lang, 'nav.contact'), item: pageUrl },
  ]),
  faqPageNode(lang, CONTACT_FAQ),
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  jsonLd={jsonLd}
  ogImage="/og-contact.jpg"
  pageType={['WebPage', 'ContactPage']}
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImagesrcset} imagesizes="100vw" />
  <InnerHeader lang={lang} />
  <main id="main-content" class="contact-page">
    {
      /* Hero in the etalon's (geo-audit) idiom family: glass-pill eyebrow
         with the breathing glow, the h1 clipping the neural texture into
         its glyphs word-by-word, the entrance cascade, the lede's periodic
         glow. The ComfyUI art layer lands here once the owner approves a
         sketch (still first, then the morph loop — same pipeline as the
         geo hero). */
    }
    <header class="contact-hero">
      {
        /* The signal in flight: one thread crossing the frame, a message
           pulse mid-way — passing right behind the title. Generated
           in-house (ComfyUI, Z-Image). */
      }
      <div class="contact-hero__art" aria-hidden="true" id="contact-hero-art">
        <Picture
          src={heroArt}
          formats={['avif', 'webp']}
          widths={[768, 1280]}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {
          /* The living signal: light leaves the centre along the thread —
             one stream to the envelope, one to the calendar. A letter,
             answered. Composited rather than generated (tools/art/
             contact-sparks.py traces the thread in this very still and runs
             the light along it), so the background never drifts and the loop
             is seamless by construction. Same gating as every hero loop. */
        }
        <video
          id="contact-hero-video"
          class="contact-hero__video"
          muted
          loop
          playsinline
          preload="none"
          data-webm="/contact-hero-loop.webm"
          data-mp4="/contact-hero-loop.mp4"></video>
      </div>
      {
        /* Born at the knot where the thread splits toward the envelope and the
           calendar — the same point the sparks leave from, measured in the
           loop's own frame (638, 385 of 1280×720). */
      }
      <NeuralPlexus
        client:idle
        originX={0.5014}
        originY={0.5347}
        anchor={{
          selector: '#contact-hero-video',
          width: 1024,
          height: 576,
          x: 0.5014,
          y: 0.5347,
        }}
        originGlow
        pace={1.8}
      />
      <div class="container">
        {
          /* The copy sits on a plate: the art behind it is a photograph, and a
             photograph will always win against unbacked text somewhere. */
        }
        <div class="contact-hero__plate hero-plate">
          <p class="contact-hero__eyebrow text-mono">
            <span aria-hidden="true">// </span>{t(lang, 'nav.contact').toLowerCase()}
          </p>
          <h1 class="contact-hero__title" aria-label={copy.h1}>
            {
              copy.h1.split(' ').map((word, wordIdx) => [
                wordIdx > 0 ? ' ' : null,
                <span class="contact-hero__word" aria-hidden="true">
                  {Array.from(word).map((char) => (
                    <span class="contact-hero__letter">{char}</span>
                  ))}
                </span>,
              ])
            }
          </h1>
          <p class="contact-hero__lede">{copy.lede}</p>
        </div>
      </div>

      {/* Full-viewport hero owes the reader a nudge (etalon pattern). */}
      <button type="button" class="contact-hero__scroll js-contact-scroll-hint">
        <span class="text-mono">{t(lang, 'hero.scroll')}</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14"></path>
          <path d="m19 12-7 7-7-7"></path>
        </svg>
      </button>
    </header>

    <section class="contact-funnel" id="contact-form" aria-labelledby="contact-form-heading">
      <div class="container">
        {
          /* The page's main block had no heading at all, so its outline read
             h1 → (unnamed) → h2 FAQ. Visually quiet, structurally load-bearing. */
        }
        <h2 id="contact-form-heading" class="contact-funnel__heading text-mono js-contact-reveal">
          <span aria-hidden="true">// </span>{copy.formHeading}
        </h2>
        {
          /* The face behind the promise — a real photo, no AI retouching.
             Forms convert to humans, not to inboxes. */
        }
        <div class="contact-answerer js-contact-reveal">
          <Image
            src={portrait}
            alt={copy.answererAlt}
            width={128}
            height={128}
            widths={[64, 128]}
            sizes="64px"
            class="contact-answerer__photo"
            loading="lazy"
            decoding="async"
          />
          <p class="contact-answerer__text">{copy.answerer}</p>
        </div>
        <ContactFunnel client:visible lang={lang} labels={copy.labels} />
        {
          /* The strongest trust claim on the page ("no backend, by design")
             previously lived only inside the Svelte success panel — serialized
             island props a crawler never renders. This is the same claim as
             plain server-rendered text, so it ships in the HTML a machine
             actually reads. */
        }
        <p class="contact-direct js-contact-reveal">{copy.backendNote}</p>
        <p class="contact-direct js-contact-reveal">
          {copy.directPre}<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>{copy.directPost}
        </p>
        {
          /* The FAQ below promises a booking link works "anytime" — not
             only after the form is submitted. This is that link: same
             CAL_BOOKING_URL the success panel uses, visible before anyone
             fills anything in, styled no louder than the plain-email
             fallback above it (secondary door, per site-config.ts). */
        }
        <p class="contact-direct js-contact-reveal">
          {copy.calPre}<a href={CAL_BOOKING_URL} target="_blank" rel="noopener noreferrer"
            >{copy.calLink}</a
          >{copy.calPost}
        </p>
        <p class="contact-direct js-contact-reveal">
          {copy.linksLinePre}<a href={`/${lang}/services/`}>{copy.linksLineLadder}</a>
          {copy.linksLineMid}<a href={`/${lang}/trust/`}>{copy.linksLineTrust}</a>
          {copy.linksLinePost}
        </p>
      </div>
    </section>

    <FaqSection lang={lang} items={CONTACT_FAQ} id="contact-faq" />
  </main>
</BaseLayout>

<script>
  // The homepage scroll engine (etalon manners): Lenis smooths the wheel;
  // a light cursor parallax on the lede. Reduced motion turns both off at
  // the source (initLenis returns null; the manners gate themselves).
  import { initLenis } from '@scripts/lenis-init';

  // The hero loop, gated like every hero loop (etalon recipe verbatim).
  function initContactVideo(): void {
    const video = document.getElementById('contact-hero-video') as HTMLVideoElement | null;
    const art = document.getElementById('contact-hero-art');
    if (!video || !art) return;

    const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const saveData =
      'connection' in navigator &&
      (navigator as { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!wantsMotion || saveData) return;

    const mp4 = video.dataset.mp4 ?? '';
    let lastVisible = false;

    // The width gate used to be evaluated once at load; a resize across the
    // 768px breakpoint (fold/unfold, devtools) never re-armed it. Arm once,
    // the first time the viewport actually qualifies.
    const arm = (): void => {
      const webm = video.dataset.webm ?? '';
      video.src = video.canPlayType('video/webm; codecs="vp9"') ? webm : mp4;

      // Codec fallback: some browsers advertise webm support but fail to
      // decode this particular VP9 profile — fall back to the mp4 sibling.
      video.addEventListener(
        'error',
        () => {
          if (video.src.endsWith('.webm') && mp4) {
            video.src = mp4;
            void video.play().catch(() => {});
          }
        },
        { once: true }
      );

      video.addEventListener(
        'playing',
        () => {
          art.classList.add('contact-hero__art--live');
        },
        { once: true }
      );

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            lastVisible = entry.isIntersecting;
            if (entry.isIntersecting) {
              void video.play().catch(() => {
                // Autoplay refused — the breathing still simply remains.
              });
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.12 }
      );
      io.observe(art);

      // bfcache: browsers pause media on bfcache entry and never
      // auto-resume it on restore.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) void video.play().catch(() => {});
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          video.pause();
        } else if (lastVisible) {
          void video.play().catch(() => {});
        }
      });
    };

    const mq = window.matchMedia('(min-width: 768px)');
    if (mq.matches) {
      arm();
    } else {
      mq.addEventListener(
        'change',
        (e) => {
          if (e.matches) arm();
        },
        { once: true }
      );
    }
  }

  function initContactManners(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const hero = document.querySelector<HTMLElement>('.contact-hero');
    const lede = document.querySelector<HTMLElement>('.contact-hero__lede');
    if (!hero || !lede) return;

    hero.addEventListener(
      'mousemove',
      (e) => {
        const r = hero.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        lede.style.transform = `translate(${nx * -3}px, ${ny * -2}px)`;
      },
      { passive: true }
    );

    hero.addEventListener('mouseleave', () => {
      lede.style.transform = '';
    });
  }

  // The scroll hint keeps its promise: Lenis rides down to the form.
  /**
   * Scroll reveal for the second half of the page — a verbatim transplant of
   * `initTrustMotion` (trust/index.astro:466), which is the site's canonical
   * recipe. Until now this page had no GSAP at all: everything below the fold
   * simply stood there, next to an animated hero.
   *
   * `gsap.from`, never `fromTo`: the copy is visible in the CSS and the tween
   * only ever animates TOWARD that state, so a failed import leaves a
   * readable page rather than an invisible one. `clearProps: 'all'` because an
   * inline opacity outlives the tween and beats `:hover` — that has bitten
   * this project before.
   *
   * The ContactFunnel island is deliberately NOT a target: it is
   * `client:visible`, and hiding its wrapper would postpone hydration and tie
   * a working form to a motion library.
   */
  async function initContactMotion(): Promise<void> {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      document.querySelectorAll<HTMLElement>('.js-contact-reveal').forEach((el) => {
        // A keyboard user can reach these before the scroll trigger fires —
        // and four of the six carry real links (the address, the booking
        // link, /services/, /trust/). Landing focus on an invisible target
        // is a trap, so focus fast-forwards the element's own tween. Four
        // other pages already do this; the recipe copied here came from the
        // one that did not.
        const tw = gsap.from(el, {
          opacity: 0,
          y: 24,
          duration: 0.7,
          ease: 'power2.out',
          clearProps: 'all',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
        el.addEventListener('focusin', () => tw.progress(1), { once: true });
      });
    } catch (err) {
      console.error('[contact] motion failed to load:', err);
    }
  }

  function initContactScrollHint(): void {
    const hint = document.querySelector<HTMLElement>('.js-contact-scroll-hint');
    const target = document.getElementById('contact-form');
    if (!hint || !target) return;

    hint.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
