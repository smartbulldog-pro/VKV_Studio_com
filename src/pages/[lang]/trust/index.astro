const copy = COPY[lang];

// The hero art is the mobile LCP element (same family as services, where a
// head preload with the real srcset was trace-confirmed to shave discovery).
// Master is 1280×720, so [768, 1280] is everything that actually ships.
const HERO_WIDTHS = [768, 1280];
const heroPreloads = await Promise.all(
  HERO_WIDTHS.map((width) => getImage({ src: heroArt, format: 'avif', width }))
);
const heroImagesrcset = heroPreloads.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`).join(', ');

const pageUrl = `${SITE_ORIGIN}/${lang}/trust/`;
const jsonLd = [
  breadcrumbNode(lang, [
    { name: t(lang, 'nav.home'), item: `${SITE_ORIGIN}/${lang}/` },
    { name: copy.h1, item: pageUrl },
  ]),
  // The tiles are literal procurement Q/A — headings are the questions,
  // bodies the answers, all visible on-page (house rule: no ratings/reviews).
  // Multi-paragraph answers are joined, so the structured answer is the same
  // text the visitor reads and never a truncated first paragraph.
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.sections.slice(1).map((s) => ({
      '@type': 'Question',
      name: s.heading,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [s.body, ...(s.bodyMore ?? [])].join(' '),
      },
    })),
  },
];
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  jsonLd={jsonLd}
  ogImage="/og-trust.jpg"
>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImagesrcset} imagesizes="100vw" />
  <InnerHeader lang={lang} />
  <main id="main-content" class="trust-page">
    {
      /* Hero in the etalon family. The art: two threads tied into one — the
         page's whole argument in a single quiet image. The plexus is born
         from the knot itself. */
    }
    <header class="trust-hero">
      <div class="trust-hero__art" aria-hidden="true" id="trust-hero-art">
        <Picture
          src={heroArt}
          formats={['avif', 'webp']}
          widths={[768, 1280]}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        {
          /* The living knot: threads tug the bow side to side, the center
             crossing holds still (WAN 5B palindrome). Same gating as every
             hero loop: desktop, motion allowed, no data-saver. */
        }
        <video
          id="trust-hero-video"
          class="trust-hero__video"
          muted
          loop
          playsinline
          preload="none"
          data-webm="/trust-hero-loop.webm"
          data-mp4="/trust-hero-loop.mp4"></video>
      </div>
      {
        /* Anchored to the knot's center crossing, measured in the video frame
           itself — cover-crop math keeps it exact at every viewport. */
      }
      <NeuralPlexus
        client:idle
        originX={0.519}
        originY={0.52}
        anchor={{ selector: '#trust-hero-video', width: 1024, height: 576, x: 0.5205, y: 0.5 }}
        originGlow
        pace={1.8}
      />
      <div class="container">
        <p class="trust-hero__eyebrow text-mono">
          <span aria-hidden="true">// </span>{copy.heroEyebrow}
        </p>
        <h1 class="trust-hero__title" aria-label={copy.h1}>
          {
            copy.h1.split(' ').map((word, wordIdx) => [
              wordIdx > 0 ? ' ' : null,
              <span class="trust-hero__word" aria-hidden="true">
                {Array.from(word).map((char) => (
                  <span class="trust-hero__letter">{char}</span>
                ))}
              </span>,
            ])
          }
        </h1>
        <p class="trust-hero__lede">{copy.lede}</p>
      </div>

      <button type="button" class="trust-hero__scroll js-trust-scroll-hint">
        <span class="text-mono">{t(lang, 'hero.scroll')}</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14"></path>
          <path d="m19 12-7 7-7-7"></path>
        </svg>
      </button>
    </header>

    {
      /* The human anchor: a real, unretouched-by-AI photo of the person the
         whole page keeps referring to. Facts beside a face — the trust
         formula no paragraph can substitute. */
    }
    <section class="trust-face" id="trust-face">
      <div class="container">
        <div class="trust-face__card glass-panel js-trust-reveal">
          <Image
            src={portrait}
            alt={copy.faceAlt}
            width={360}
            height={360}
            widths={[132, 180, 264, 360]}
            sizes="(max-width: 639px) 132px, 180px"
            class="trust-face__photo"
            loading="lazy"
          />
          <div class="trust-face__text">
            <p class="trust-face__label text-mono">
              <span aria-hidden="true">// </span>{copy.faceLabel.replace('// ', '')}
            </p>
            <p class="trust-face__name">{copy.faceName}</p>
            <p class="trust-face__line">{copy.faceLine}</p>
          </div>
        </div>
      </div>
    </section>

    {
      /* Not one canvas (owner): the credo becomes a philosophy callout,
         and the procurement answers become numbered glass tiles —
         the etalon's deliverables idiom carrying diligence instead. */
    }
    <section class="trust-body">
      <div class="container">
        {
          copy.sections[0] && (
            <blockquote class="trust-callout js-trust-reveal">
              <h2 class="trust-callout__label text-mono">{copy.sections[0].heading}</h2>
              <p class="trust-callout__text">{copy.sections[0].body}</p>
            </blockquote>
          )
        }

        <p class="trust-grid__eyebrow text-mono js-trust-reveal">
          <span aria-hidden="true">// </span>{copy.gridEyebrow.replace('// ', '')}
        </p>
        <h2 class="trust-grid__heading js-trust-reveal">{copy.gridHeading}</h2>
        <div class="trust-grid">
          {
            copy.sections.slice(1).map((s) => (
              <MagneticCard client:visible strength={0.2}>
                <article
                  class:list={[
                    'trust-tile',
                    'js-trust-tile-reveal',
                    s.bodyMore && 'trust-tile--wide',
                  ]}
                >
                  {s.emblem && (
                    <div class="trust-tile__emblem" aria-hidden="true">
                      <Picture
                        src={s.emblem}
                        formats={['avif', 'webp']}
                        widths={[240, 480]}
                        sizes="240px"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <h3>{s.heading}</h3>
                  <p>{s.body}</p>
                  {s.bodyMore?.map((para) => (
                    <p>{para}</p>
                  ))}
                  {s.link && (
                    <p class="trust-tile__link">
                      <a href={s.link.href}>
                        {s.link.text} <span aria-hidden="true">→</span>
                      </a>
                    </p>
                  )}
                </article>
              </MagneticCard>
            ))
          }
        </div>
      </div>
    </section>

    <ServiceCta lang={lang} outcome={t(lang, 'services.ctaOutcomes.trust')} />
  </main>
</BaseLayout>

<script>
  // Etalon motion grammar: Lenis, per-element reveals, lede parallax, the
  // scroll hint's promise. Nothing hidden by CSS — gsap.from owns it all.
  import { initLenis } from '@scripts/lenis-init';

  async function initTrustMotion(): Promise<void> {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      document.querySelectorAll<HTMLElement>('.js-trust-reveal').forEach((el) => {
        // A keyboard user can reach these before the scroll trigger fires.
        // Landing focus on an invisible target is a trap, so focus
        // fast-forwards the element's own tween — the recipe copied here
        // came from the page that established it. The tile grid below gets
        // the same guard on its own tween, which is where the real links
        // on this page (the privacy policy, the retainers page) actually
        // live.
        const tw = gsap.from(el, {
          opacity: 0,
          y: 24,
          duration: 0.7,
          ease: 'power2.out',
          clearProps: 'all',
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
        el.addEventListener('focusin', () => tw.progress(1), { once: true });
      });

      // The nine procurement tiles get their own entrance — the geo-audit
      // deliverables recipe (rise and settle from a slight scale) rather
      // than the plain fade-up above, so the grid reads as its own beat
      // instead of blending into the page's general reveal cadence. Same
      // focusin guard: two of the nine carry real links (the privacy
      // policy, the retainers page), and landing keyboard focus on an
      // invisible tile is a trap either way.
      document.querySelectorAll<HTMLElement>('.js-trust-tile-reveal').forEach((el) => {
        const tw = gsap.fromTo(
          el,
          { opacity: 0, y: 50, scale: 0.92 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.7,
            ease: 'expo.out',
            clearProps: 'all',
            scrollTrigger: { trigger: el, start: 'top 82%' },
          }
        );
        el.addEventListener('focusin', () => tw.progress(1), { once: true });
      });
    } catch (err) {
      console.error('[trust] motion failed to load:', err);
    }
  }

  // The hero loop, gated like every hero loop (etalon recipe verbatim).
  function initTrustVideo(): void {
    const video = document.getElementById('trust-hero-video') as HTMLVideoElement | null;
    const art = document.getElementById('trust-hero-art');
    if (!video || !art) return;

    const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const saveData =
      'connection' in navigator &&
      (navigator as { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (!wantsMotion || saveData) return;

    let lastVisible = false;

    // The width gate is evaluated once at call time by default — a resize
    // across the breakpoint (e.g. rotating a tablet) would never arm the
    // loop. Arm on first match, whether that's now or after a later resize.
    const mq = window.matchMedia('(min-width: 768px)');
    const arm = () => {
      const webm = video.dataset.webm ?? '';
      const mp4 = video.dataset.mp4 ?? '';
      video.src = video.canPlayType('video/webm; codecs="vp9"') ? webm : mp4;
      video.addEventListener(
        'playing',
        () => {
          art.classList.add('trust-hero__art--live');
        },
        { once: true }
      );
      video.addEventListener(
        'error',
        () => {
          if (video.src.endsWith('.webm') && mp4) {
            video.src = mp4;
            void video.play().catch(() => {});
          }
        },
        { once: true }
      );

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            lastVisible = entry.isIntersecting;
            if (entry.isIntersecting) {
              void video.play().catch(() => {
                // Autoplay refused — the breathing still simply remains.
              });
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.12 }
      );
      io.observe(art);

      // Browsers pause media on bfcache entry and never auto-resume it.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) void video.play().catch(() => {});
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          video.pause();
        } else if (lastVisible) {
          void video.play().catch(() => {});
        }
      });
    };

    if (mq.matches) {
      arm();
    } else {
      mq.addEventListener(
        'change',
        (e) => {
          if (e.matches) arm();
        },
        { once: true }
      );
    }
  }

  function initTrustManners(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const hero = document.querySelector<HTMLElement>('.trust-hero');
    const lede = document.querySelector<HTMLElement>('.trust-hero__lede');
    if (!hero || !lede) return;

    hero.addEventListener(
      'mousemove',
      (e) => {
        const r = hero.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        lede.style.transform = `translate(${nx * -3}px, ${ny * -2}px)`;
      },
      { passive: true }
    );

    hero.addEventListener('mouseleave', () => {
      lede.style.transform = '';
    });
  }

  function initTrustScrollHint(): void {
    const hint = document.querySelector<HTMLElement>('.js-trust-scroll-hint');
    const target = document.getElementById('trust-face');
    if (!hint || !target) return;

    hint.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = (
        window as Window & {
          lenisInstance?: { scrollTo: (t: Element, o?: Record<string, unknown>) => void };
        }
      ).lenisInstance;
      if (lenis && !reduced) {
        lenis.scrollTo(target, { duration: 1.6 });
      } else {
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLenis();
      void initTrustMotion();
      initTrustVideo();
      initTrustManners();
      initTrustScrollHint();
    });
  } else {
    initLenis();
    void initTrustMotion();
    initTrustVideo();
    initTrustManners();
    initTrustScrollHint();
  }
</script>

<style>
  .trust-page {
    padding-top: var(--space-10);
    min-height: 100vh;
    background: var(--bg-obsidian);
  }

  @media (max-width: 767px) {
    .trust-page {
      padding-top: var(--space-4);
    }
  }

  /* ── Hero: the etalon idiom family ─────────────────── */
  .trust-hero {
    position: relative;
    text-align: center;
    padding-block: var(--space-8) var(--space-12);
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100vh - 7.5rem);
    min-height: calc(100svh - 7.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Text rides the upper third; the knot glows on the calm band below. */
    justify-content: flex-start;
    padding-top: clamp(3rem, 12vh, 7rem);
  }

  .trust-hero .container {
    position: relative;
    z-index: 1;
  }

  .trust-hero__art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .trust-hero__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trust-hero__art :global(img) {
      animation: trust-breathe 9s ease-in-out infinite alternate;
      will-change: transform;
    }
  }

  @keyframes trust-breathe {
    from {
      transform: scale(1);
      filter: brightness(1);
    }
    to {
      transform: scale(1.035);
      filter: brightness(1.15);
    }
  }

  .trust-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }

  .trust-hero__art--live .trust-hero__video {
    opacity: 0.55;
  }

  /* The still leaves entirely once the loop plays — its differently
     framed ghost doubled the knot (owner caught it). */
  .trust-hero__art--live :global(img) {
    opacity: 0;
    animation: none;
  }

  .trust-hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--bg-obsidian) 2%, transparent 30%),
      linear-gradient(to top, var(--bg-obsidian) 4%, transparent 35%);
  }

  .trust-hero__eyebrow {
    display: inline-block;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    color: hsl(155, 85%, 65%);
    padding: var(--space-1) var(--space-4);
    background: hsla(220, 25%, 6%, 0.9);
    border: 1px solid hsla(155, 50%, 40%, 0.2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-shadow: 0 0 12px var(--accent-glow);
    transition:
      color 0.4s ease-out,
      border-color 0.4s ease-out,
      background 0.4s ease-out;
    cursor: default;
    margin-bottom: var(--space-4);
  }

  /* The standard property, restated where the CSS minifier cannot rewrite it
     away: in the built bundle it collapses `backdrop-filter` into the -webkit-
     alias alone, and Firefox (standard-only) then renders a flat fill. The
     minifier does not merge across an @supports boundary, so this copy ships.
     Must stay AFTER the base rule — equal specificity, last one wins.
     Same idiom as .glass-panel / .hero-plate in src/styles/global.css. */
  @supports (backdrop-filter: blur(1px)) {
    .trust-hero__eyebrow {
      backdrop-filter: blur(12px);
    }
  }

  .trust-hero__eyebrow:hover {
    color: hsl(220, 70%, 65%);
    border-color: hsla(220, 50%, 50%, 0.25);
    text-shadow: 0 0 12px hsla(220, 70%, 60%, 0.4);
  }

  .trust-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 20ch;
    margin: 0 auto var(--space-5);

    background-image: image-set(
      url('/neural-texture.avif') type('image/avif'),
      url('/neural-texture.webp') type('image/webp')
    );
    background-position: center center;
    background-size: cover;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    -webkit-text-stroke: 2px hsla(180, 80%, 55%, 0.7);

    filter: drop-shadow(0 0 2px hsla(0, 0%, 0%, 0.8)) drop-shadow(0 0 6px hsla(0, 0%, 0%, 0.5));
  }

  @supports not (background-image: image-set(url('/neural-texture.avif') type('image/avif'))) {
    .trust-hero__title {
      background-image: url('/neural-texture.jpg');
    }
  }

  @media (max-width: 767px) {
    .trust-hero__title {
      background-image: image-set(
        url('/neural-texture-mobile.avif') type('image/avif'),
        url('/neural-texture-mobile.webp') type('image/webp')
      );
    }
  }

  .trust-hero__word {
    white-space: nowrap;
  }

  .trust-hero__letter {
    transition:
      -webkit-text-stroke-color var(--duration-slow, 0.4s) var(--ease-out, ease-out),
      text-shadow var(--duration-slow, 0.4s) var(--ease-out, ease-out);
    cursor: default;
  }

  .trust-hero__letter:hover {
    -webkit-text-stroke-color: hsla(180, 90%, 70%, 0.95);
    text-shadow:
      0 0 10px hsla(180, 85%, 60%, 0.55),
      0 0 22px hsla(180, 85%, 55%, 0.3);
  }

  .trust-hero__lede {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    max-width: 60ch;
    margin: 0 auto;
    line-height: 1.7;
  }

  .trust-hero__scroll {
    position: absolute;
    /* The gesture bar on a modern phone owns the last ~34px of the viewport;
       a hint pinned at a bare --space-6 sits inside it. */
    bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2);
    background: transparent;
    border: 0;
    color: var(--text-ghost);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s ease-out;
  }

  .trust-hero__scroll:hover,
  .trust-hero__scroll:hover .text-mono {
    color: var(--accent-green-200);
  }

  @media (prefers-reduced-motion: no-preference) {
    .trust-hero__eyebrow {
      animation:
        trust-fade-up-15 0.6s ease-out 0.15s backwards,
        trust-eyebrow-breathe 4s ease-in-out 1.5s infinite;
    }

    .trust-hero__title {
      animation:
        trust-title-opacity-in 0.7s ease-out 0.15s backwards,
        trust-title-transform-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s backwards;
    }

    .trust-hero__lede {
      animation:
        trust-fade-up-15 0.6s ease-out 0.3s backwards,
        trust-lede-glow 5s ease-in-out 2s infinite;
    }

    .trust-hero__scroll svg {
      animation: trust-scroll-nudge 2.2s ease-in-out 2.5s infinite;
    }
  }

  @keyframes trust-fade-up-15 {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes trust-title-opacity-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes trust-title-transform-in {
    from {
      transform: translateY(20px);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes trust-eyebrow-breathe {
    0%,
    100% {
      text-shadow: 0 0 12px var(--accent-glow);
    }
    50% {
      text-shadow:
        0 0 20px var(--accent-glow-strong),
        0 0 40px var(--accent-glow);
    }
  }

  @keyframes trust-lede-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 0 transparent);
    }
    50% {
      filter: drop-shadow(0 0 20px hsla(155, 60%, 60%, 0.08));
    }
  }

  @keyframes trust-scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-hero__letter {
      transition: none;
    }
  }

  .trust-body {
    margin-bottom: var(--space-8);
  }

  /* The credo — Engineering Philosophy idiom, verbatim family. */
  .trust-callout {
    max-width: var(--container-narrow);
    padding: var(--space-8) var(--space-8) var(--space-8) var(--space-10);
    border-left: 2px solid var(--accent-green-300);
    background: hsla(155, 65%, 50%, 0.03);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 0 0 var(--space-16);
  }

  .trust-callout__label {
    /* An h2 for the outline, an eyebrow to the eye — undo heading weight. */
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    margin-bottom: var(--space-3);
  }

  .trust-callout__text {
    font-size: var(--text-lg);
    color: var(--text-primary);
    font-style: italic;
    line-height: var(--leading-relaxed);
    font-weight: var(--weight-medium);
    margin: 0;
  }

  .trust-grid__eyebrow {
    margin-bottom: var(--space-4);
  }

  .trust-grid__heading {
