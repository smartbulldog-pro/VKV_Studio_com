const page = content[activeLang] || content.en;
const metaTitle = t(activeLang, 'privacy.metaTitle');
const metaDescription = t(activeLang, 'privacy.metaDescription');

const homeUrl = `https://vkvstudio.com/${activeLang}/`;
const privacyUrl = `https://vkvstudio.com/${activeLang}/privacy/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(activeLang, 'nav.home'), item: homeUrl },
      { '@type': 'ListItem', position: 2, name: t(activeLang, 'privacy.h1'), item: privacyUrl },
    ],
  },
];

// The hero art is this page's LCP element, and PageHero cannot preload it for
// us: an Astro slot does not travel from a nested component up to BaseLayout's
// `head` slot (src/components/blocks/README.md — "What it does NOT do"). The
// widths must stay identical to the ones the component asks for, or the
// preload is a second download: the master is 1280 wide, so the component's
// family resolves to exactly [768, 1280]; anything larger would clamp to the
// master and emit a duplicate URL.
const HERO_WIDTHS = [768, 1280];
const heroPreloads = await Promise.all(
  HERO_WIDTHS.map((width) => getImage({ src: heroArt, format: 'avif', width }))
);
const heroImagesrcset = heroPreloads.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`).join(', ');
---

<BaseLayout title={metaTitle} description={metaDescription} lang={activeLang} jsonLd={jsonLd}>
  <link slot="head" rel="preload" as="image" imagesrcset={heroImagesrcset} imagesizes="100vw" />
  <InnerHeader lang={activeLang} />
  <main id="main-content" class="privacy-page">
    {
      /* The shared inner-page hero (src/components/blocks/PageHero.astro).
         The "last updated" line and the long disclosure paragraph still live
         in the content section below, outside the hero: a hero states the
         page's identity, it does not carry the fine print.

         MINIMUM SUFFICIENT HERO FOR A LEGAL PAGE — what is here and, more to
         the point, what is not:
           · art + scrim + plate — kept. The complaint being answered is that
             these heroes read as empty, and that is as true of a policy page
             as of any other; the plate is what keeps a legal text legible
             over a picture, and the component derives it from the art.
           · scrim="center" — the cluster's light is dead centre, exactly
             under the copy, so the centre-darkening (radial) scrim is the
             one that protects the words here.
           · NO plexus. Two reasons, and both are about this page. The
             picture's whole statement is a cluster sealed inside a closed
             boundary with nothing leaving it — a live network sprawling
             across the frame and reaching for the cursor would contradict
             the one thing the picture says. And this page carries no islands
             at all today (see the script below); a policy is read, not
             played with, so it keeps its zero-hydration budget.
           · no video, no `align="top"`, no `under-lede` block — a legal page
             has nothing to put under its lede but the policy itself, which
             is one scroll-hint away. */
    }
    <PageHero
      lang={activeLang}
      eyebrow={t(activeLang, 'privacy.eyebrow')}
      title={t(activeLang, 'privacy.h1')}
      lede={t(activeLang, 'privacy.heroLede')}
      image={heroArt}
      scrim="center"
      scrollTarget="#privacy-content"
    />

    <section class="privacy-content" id="privacy-content">
      <div class="container container--narrow">
        {
          /* Quick index of policy sections — idiom copied from `.log-index`
             (src/pages/[lang]/log/index.astro): a graphite panel holding a
             plain list of anchors, one per section, landing on that
             section's own `id`. Built entirely from `page.sections` (the
             same `id`/`title` pairs the sections below render from) — no
             new copy, no new i18n key. Two pieces of the log idiom are
             deliberately not copied: the `<time>` column (privacy sections
             carry no per-section date, unlike log entries) and the
             `.log-index__label` caption — privacy sections need no visible
             caption, the panel explains itself. The landmark still needs a
             name (the page's header nav is labeled, and two unlabeled
             `navigation` landmarks read identically in a rotor), so the
             `aria-label` reuses the boilerplate `privacy.contents` key. */
        }
        <nav class="privacy-index" aria-label={t(activeLang, 'privacy.contents')}>
          <ol class="privacy-index__list">
            {
              page.sections.map((section, i) => (
                <li>
                  <a href={`#${section.id}`} class="privacy-index__item">
                    <span class="privacy-index__n text-mono">{String(i + 1).padStart(2, '0')}</span>
                    <span class="privacy-index__title">{section.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
        <p class="privacy-updated text-mono">
          <time datetime={page.updatedISO}>{page.updated}</time>
        </p>
        <p class="text-secondary privacy-intro">{page.intro}</p>
        {
          page.sections.map((section) => (
            <section class="privacy-section" id={section.id}>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // The homepage's scroll engine. Safe here: this page still carries no
  // islands at all, so nothing competes with Lenis for wheel/scroll input.
  //
  // Lenis starts HERE, not inside the hero: it drives the whole page, and
  // PageHero's scroll hint only borrows `window.lenisInstance` if something
  // has already published it. The hint's click handler moved into the
  // component. The hero's lede parallax did NOT move — it is gone: the
  // component deliberately offers no such hook, reaching `.page-hero__lede`
  // from a page script would rebuild exactly the coupling the component
  // removes, and the measurement (.system/canon/92-hero-diff.md §3.3) classes
  // that parallax as drift — present on nine pages, absent on seven,
  // justified on none. On a legal page it is the wrong instinct anyway: text
  // a reader may need to quote should hold still.
  import { initLenis } from '@scripts/lenis-init';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initLenis();
    });
  } else {
    initLenis();
  }
</script>

<style>
  .privacy-page {
    padding-top: var(--space-10);
    padding-bottom: var(--space-24);
    min-height: 100vh;
    background: var(--bg-obsidian);
  }

  /* No fixed header on this page (InnerHeader is static, not fixed) — a
     desktop-sized top offset is just dead air on a phone. */
  @media (max-width: 767px) {
    .privacy-page {
      padding-top: var(--space-4);
    }
  }

  /* The hero's own rules (frame, plate, eyebrow, title, letters, lede,
     entrance cascade, keyframes and the scroll hint — 228 lines) now live in
     src/components/blocks/PageHero.astro. Nothing left on this page targets
     a `.privacy-hero*` class, so every one of those rules was dead here. */

  /* NOTE: this whole rule is redundant — the element already carries
     `container container--narrow`, which is where the narrow measure comes
     from (global.css), and the log page does exactly that with no override.
     Removing a rule is a deletion, and deletions go through the owner, so it
     stays; what changed is the one declaration that was actively wrong. The
     flat 16px overwrote `.container`'s `max(padding, env(safe-area-inset-*))`,
     which is what keeps text out from under the camera notch in landscape,
     and capped the side air at 16px where the clamp gives up to 48px. */
  .privacy-content .container {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding-left: max(var(--container-padding), env(safe-area-inset-left, 0px));
    padding-right: max(var(--container-padding), env(safe-area-inset-right, 0px));
  }

  /* ── Index of sections ──────────────────────────────────────────
     Idiom copied from `.log-index` (src/pages/[lang]/log/index.astro):
     graphite panel, mono numerals, hover-tints the title green. See the
     markup comment above for the two pieces of that idiom left out here
     (the date column, the caption) and why. */
  .privacy-index {
    margin-bottom: var(--space-8);
    padding: var(--space-6);
    background: var(--bg-graphite);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .privacy-index__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .privacy-index__item {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-2) 0;
    text-decoration: none;
  }

  /* Same touch-target fix as the log idiom (ui-ux-pro-max CRITICAL): a
     single-line item's padding alone does not clear 44px on a phone.
     Mobile-scoped, same 767px breakpoint as `.log-index__item`. */
  @media (max-width: 767px) {
    .privacy-index__list {
      gap: var(--space-2);
    }

    .privacy-index__item {
      padding: var(--space-3) 0;
      min-height: 44px;
    }
  }

  .privacy-index__n {
    flex-shrink: 0;
    color: var(--accent-green-300);
    font-size: var(--text-sm);
  }

  .privacy-index__title {
    color: var(--text-secondary);
    line-height: var(--leading-snug);
    transition: var(--transition-colors);
  }

  .privacy-index__item:hover .privacy-index__title,
  .privacy-index__item:focus-visible .privacy-index__title {
    color: var(--accent-green-300);
  }

  .privacy-updated {
    margin-bottom: var(--space-6);
    color: var(--text-ghost);
  }

  .privacy-intro {
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .privacy-section {
    /* Every section carries an id and the policy links to them by name, so
       they are externally linkable; without this the heading lands flush
       against the top edge of the window. Same value as the log's entries
       and the three Lab pages. */
    scroll-margin-top: var(--space-24);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }

  .privacy-section:first-child {
    border-top: none;
    padding-top: 0;
  }

  .privacy-section h2 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }

  .privacy-section p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .privacy-section p:last-child {
    margin-bottom: 0;
  }

  .privacy-section ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .privacy-section li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .privacy-section li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent-green-400);
  }
</style>
