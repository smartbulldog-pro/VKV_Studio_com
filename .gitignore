# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — НИКОГДА не коммитить! Содержат API ключи.
.env
.env.*
inference/.env
**/*.env
# ...but the checked-in template (no secrets, just documents the var name) stays tracked
!.env.example

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
.vscode/settings.json

# Claude Code — local-only. Skills are junctions into .agents/skills (already in git);
# re-create them with the command in ПАМЯТКА_CLAUDE_CODE.md §2 after cloning.
.claude/skills/
.claude/settings.local.json

# ── Training / ML artifacts ──────────────────────────
training/.venv/
training/.venv-cuda/
training/llama.cpp/
training/llama_converter/
training/models/
training/checkpoints/
training/output/
training/unsloth_compiled_cache/
training/scripts/unsloth_compiled_cache/
training/*.gguf
training/*.safetensors

# ── Inference server ─────────────────────────────────
inference/.venv/
inference/models/*.gguf
inference/voices/*.wav
inference/voices/*.mp3
# PII: real chat history + IPs — must NEVER be in git
inference/synapse_chats.db
inference/*.db
# Heavy binaries — installed locally, not versioned
inference/*.whl
inference/llama-bin/

# llama-server child-process logs (regenerated at runtime by the LLM router)
inference/llama-server.*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# heavy asset originals — backup only, not served/committed
/_originals_backup/

# Synapse dataset v2 — intermediate build artifacts
.system/datasets/_staging/
**/__pycache__/
unsloth_compiled_cache/

# regenerable audit sample
.system/datasets/_audit_sample.txt

# dataset backups
.system/datasets/*.bak
training/eval/runs/*_msg.txt
inference/rag/corpus_vectors.json

# Lighthouse harness scratch output (.system/measure.py) — regenerable
.system/_lh/

# stray backend run logs — dev scratch, not part of the release
*.out
